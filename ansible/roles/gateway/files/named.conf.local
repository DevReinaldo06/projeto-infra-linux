// Zona direta: nome -> IP
zone "empresa.local" {
    type master;
    file "/etc/bind/zones/db.empresa.local";
};

// Zonas reversas: IP -> nome (uma por rede)
zone "1.0.10.in-addr.arpa" { type master; file "/etc/bind/zones/db.10.0.1"; };
zone "2.0.10.in-addr.arpa" { type master; file "/etc/bind/zones/db.10.0.2"; };
zone "3.0.10.in-addr.arpa" { type master; file "/etc/bind/zones/db.10.0.3"; };//
// Do any local configuration here
//

// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";

