*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
# R1 - DNAT: WAN (enp0s3) 80/443 vira web-dmz 10.0.1.10
-A PREROUTING -i enp0s3 -p tcp --dport 80 -m comment --comment "R1_dnat_80" -j DNAT --to-destination 10.0.1.10:80
-A PREROUTING -i enp0s3 -p tcp --dport 443 -m comment --comment "R1_dnat_443" -j DNAT --to-destination 10.0.1.10:443
# R8/R9 - Quem sai pela WAN usa o IP da WAN (MASQUERADE)
-A POSTROUTING -o enp0s3 -m comment --comment "R8_R9_masq" -j MASQUERADE
COMMIT

*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
:PROVISION - [0:0]

# INPUT: tráfego destinado ao próprio fw-gw
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment "R0_input_est" -j ACCEPT
# R4 - SSH do admin-lan (10.0.2.50) no fw-gw (vindo pela LAN - enp0s9)
-A INPUT -i enp0s9 -s 10.0.2.50/32 -p tcp --dport 22 -m comment --comment "R4_ssh_fw" -j ACCEPT
# R7 - DNS das três zonas
-A INPUT -i enp0s8 -s 10.0.1.0/24 -p udp --dport 53 -m comment --comment "R7_dns_dmz_udp" -j ACCEPT
-A INPUT -i enp0s8 -s 10.0.1.0/24 -p tcp --dport 53 -m comment --comment "R7_dns_dmz_tcp" -j ACCEPT
-A INPUT -i enp0s9 -s 10.0.2.0/24 -p udp --dport 53 -m comment --comment "R7_dns_lan_udp" -j ACCEPT
-A INPUT -i enp0s9 -s 10.0.2.0/24 -p tcp --dport 53 -m comment --comment "R7_dns_lan_tcp" -j ACCEPT
-A INPUT -i enp0s10 -s 10.0.3.0/24 -p udp --dport 53 -m comment --comment "R7_dns_db_udp" -j ACCEPT
-A INPUT -i enp0s10 -s 10.0.3.0/24 -p tcp --dport 53 -m comment --comment "R7_dns_db_tcp" -j ACCEPT
# R7 - DHCP somente na LAN (enp0s9)
-A INPUT -i enp0s9 -p udp --sport 68 --dport 67 -m comment --comment "R7_dhcp" -j ACCEPT

# FORWARD: tráfego entre zonas
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment "R0_fwd_est" -j ACCEPT
# R1 - Após o DNAT o destino já é 10.0.1.10 (saindo para a DMZ - enp0s8)
-A FORWARD -i enp0s3 -o enp0s8 -d 10.0.1.10/32 -p tcp -m multiport --dports 80,443 -m comment --comment "R1_fwd_web" -j ACCEPT
# R4 - admin-lan por SSH para todas as zonas
-A FORWARD -i enp0s9 -s 10.0.2.50/32 -p tcp --dport 22 -m comment --comment "R4_fwd_ssh" -j ACCEPT
# R2 - web-dmz para db-zone (DEVE vir antes da R5)
-A FORWARD -i enp0s8 -o enp0s10 -s 10.0.1.10/32 -d 10.0.3.10/32 -p tcp --dport 5432 -m comment --comment "R2_web_db" -j ACCEPT
# R6 - db-zone envia backup ao file-lan
-A FORWARD -i enp0s10 -o enp0s9 -s 10.0.3.10/32 -d 10.0.2.10/32 -p tcp --dport 445 -m comment --comment "R6_db_file" -j ACCEPT
# R5 - DMZ e WAN para DB Zone: registra e descarta
-A FORWARD -i enp0s8 -o enp0s10 -m limit --limit 5/min -j LOG --log-prefix "R5-DB-DROP: "
-A FORWARD -i enp0s8 -o enp0s10 -m comment --comment "R5_dmz_db_drop" -j DROP
-A FORWARD -i enp0s3 -o enp0s10 -m limit --limit 5/min -j LOG --log-prefix "R5-DB-DROP: "
-A FORWARD -i enp0s3 -o enp0s10 -m comment --comment "R5_wan_db_drop" -j DROP
# R8 - Janela de instalação: chain PROVISION
-A FORWARD -i enp0s8 -o enp0s3 -j PROVISION
-A FORWARD -i enp0s10 -o enp0s3 -j PROVISION
# R9 - LAN para a internet
-A FORWARD -i enp0s9 -o enp0s3 -p tcp -m multiport --dports 80,443,53 -m comment --comment "R9_lan_net_tcp" -j ACCEPT
-A FORWARD -i enp0s9 -o enp0s3 -p udp --dport 53 -m comment --comment "R9_lan_net_udp" -j ACCEPT
COMMIT